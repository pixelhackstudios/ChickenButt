<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>@APP_NAME@</name>
  <summary>Chat with local Ollama models</summary>

  <developer id="io.github.pixelhackstudios">
    <name>PixelHack Studios</name>
  </developer>

  <description>
    <p>
      ChickenButt is a lightweight desktop client for chatting with
      Ollama models running on your own computer.
    </p>
    <p>
      It provides streaming responses, local multi-chat history,
      Markdown and code rendering, model controls, and clear Ollama
      health information in a native GNOME application.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <provides>
    <binary>chickenbutt</binary>
  </provides>

  <url type="homepage">https://www.chickenbutt.dev/</url>
  <url type="vcs-browser">https://github.com/pixelhackstudios/ChickenButt</url>
  <url type="bugtracker">https://github.com/pixelhackstudios/ChickenButt/issues</url>

  <screenshots>
    <screenshot type="default">
      <caption>Chat with a local Ollama model</caption>
      <image>https://www.chickenbutt.dev/screenshot-chat.png</image>
    </screenshot>
    <screenshot>
      <caption>Welcome and empty-state layout</caption>
      <image>https://www.chickenbutt.dev/screenshot-welcome.png</image>
    </screenshot>
    <screenshot>
      <caption>Model controls and multi-chat sidebar</caption>
      <image>https://www.chickenbutt.dev/screenshot-model.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="@VERSION@" date="2026-08-07">
      <description>
        <p>Version 0.1.3: Flatpak no longer tries to load unavailable host Yaru GTK theme resources; follows system light/dark via Adwaita/libadwaita. Includes reasoning transcript from 0.1.2.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-08-06">
      <description>
        <p>Version 0.1.2: Reasoning/thinking transcript support with Show reasoning toggle, persistence and Ollama history, Continue/regenerate handling, and SQLite v1→v2 migration.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-08-05">
      <description>
        <p>Version 0.1.1: Flatpak packaging with settings (connection, per-model controls, Model Fit) and aligned release metadata.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>
</component>
