#!/bin/sh
# Generated by Meson from packaging/chickenbutt.in — do not edit installed copy.
# Flatpak: host/portal may inject GTK_THEME=Yaru-*, which has no gresource in
# org.gnome.Platform. Prefer Adwaita so GTK tokens and light/dark work. Brand
# is app CSS + WebKit, not this theme name.
if [ -n "${FLATPAK_ID:-}" ]; then
  export GTK_THEME=Adwaita
fi
exec python3 '@PKGLIBDIR@/main.py' "$@"
